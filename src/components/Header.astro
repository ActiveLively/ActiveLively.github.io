---
import Menu from "./Menu.astro";
import Navigation from "./Navigation.astro";

---

<header>
  <nav>
    <div>
      <Menu />
    </div>
    <Navigation />
  </nav>
</header>

<style>
    header {
        position: sticky;               /* Stays at the top while scrolling */
        top: 0;
        z-index: 50;                    /* Sits above images and other content */
        background-color: var(--bg-page);
    }
    nav {
        display: flex;
        justify-content: space-between; /* Pushes div to left, Navigation to right */
        align-items: center;            /* Vertically centers items */
        padding-right: 3rem;            /* ADDS THE PADDING YOU ASKED FOR */
    }
  div {
    display: flex;
    justify-content: space-between;
  }

  /* Phones: Menu button on top, links drop down underneath */
  @media screen and (max-width: 636px) {
    nav {
      flex-direction: column;
      padding: 0.5rem 0 0;
    }
  }
</style>