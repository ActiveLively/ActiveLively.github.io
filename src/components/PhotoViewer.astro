---
// src/components/PhotoViewer.astro
// The dialog that opens when a carousel photo is clicked.
// Filled in and driven by src/scripts/photoViewer.js.
---

<dialog id="photo-viewer" class="modal">
  <div class="modal-box pv-box">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost pv-close" aria-label="Close">✕</button>
    </form>

    <div class="pv-layout">
      <!-- Fixed-size stage: the photo is centred in it and the arrows stay put -->
      <div class="pv-stage">
        <div class="pv-frame">
          <div class="pv-zoom">
            <img class="pv-img" crossorigin="anonymous" alt="" draggable="false" />
          </div>
        </div>
        <button type="button" class="pv-nav pv-prev" aria-label="Previous photo">‹</button>
        <button type="button" class="pv-nav pv-next" aria-label="Next photo">›</button>
      </div>

      <aside class="pv-info">
        <p class="pv-album"><span class="pv-album-name"></span> <span class="pv-count"></span></p>
        <dl class="pv-meta"></dl>

        <h3 class="pv-heading">Palette</h3>
        <ul class="pv-palette"></ul>
        <div class="pv-theme">
          <button type="button" class="btn btn-xs pv-theme-apply">Use as page theme</button>
          <button type="button" class="btn btn-xs btn-ghost pv-theme-reset" hidden>Default theme</button>
        </div>

        <h3 class="pv-heading">Noise</h3>
        <div class="pv-controls">
          <input
            id="pv-noise"
            class="range range-xs pv-slider"
            type="range"
            min="0"
            max="1000"
            step="1"
            value="0"
            aria-label="Noise"
          />
          <output class="pv-t" for="pv-noise">t = 0</output>
          <button type="button" class="btn btn-xs pv-reset" disabled>Reset</button>
        </div>
      </aside>
    </div>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<style is:global>
  /* Desktop: a fixed-height window; the photo stage fills its full height
     and the info column scrolls if it ever runs taller */
  #photo-viewer {
    --pv-pad: 1.25rem;
    --pv-box-h: min(92vh, 64rem);
    --pv-stage-h: calc(var(--pv-box-h) - 2 * var(--pv-pad));
  }
  #photo-viewer .pv-box {
    position: relative;
    width: min(84rem, 96vw);
    max-width: none;
    height: var(--pv-box-h);
    max-height: none;
    padding: var(--pv-pad);
    overflow: hidden;
  }
  #photo-viewer .pv-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 3;
  }

  #photo-viewer .pv-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 1.25rem;
    height: 100%;
  }
  #photo-viewer .pv-info {
    min-height: 0;
    overflow-y: auto;
  }

  /* Phones: photo on top, info underneath, the whole window scrolls */
  @media (max-width: 767px) {
    #photo-viewer {
      --pv-pad: 1rem;
      --pv-stage-h: 55vh;
    }
    #photo-viewer .pv-box {
      height: auto;
      max-height: 94vh;
      overflow-y: auto;
    }
    #photo-viewer .pv-layout {
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    #photo-viewer .pv-info { overflow: visible; }
  }

  /* Fixed-size area the photo is centred in, so the arrows never move */
  #photo-viewer .pv-stage {
    position: relative;
    height: var(--pv-stage-h);
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Photo, with the noise canvas laid exactly on top. The frame clips;
     .pv-zoom is what gets scaled and moved when zooming. */
  #photo-viewer .pv-frame {
    position: relative;
    max-width: 100%;
    line-height: 0;
    border-radius: 0.5rem;
    overflow: hidden;
    touch-action: none; /* pinch / pan / swipe are handled in zoomPan.js */
  }
  #photo-viewer .pv-frame.is-zoomed { cursor: grab; }
  #photo-viewer .pv-frame.is-panning { cursor: grabbing; }
  #photo-viewer .pv-zoom {
    position: relative;
    transform-origin: 0 0;
  }
  #photo-viewer .pv-img {
    display: block;
    max-width: 100%;
    max-height: var(--pv-stage-h);
    width: auto;
    height: auto;
    user-select: none;
    -webkit-user-select: none;
  }
  #photo-viewer .pv-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Previous / next arrows, pinned to the stage's edges */
  #photo-viewer .pv-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: -1.125rem;
    border: 0;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.15s ease, background-color 0.15s ease;
  }
  #photo-viewer .pv-nav:hover,
  #photo-viewer .pv-nav:focus-visible {
    opacity: 1;
    background: rgb(0 0 0 / 0.65);
  }
  #photo-viewer .pv-nav:disabled { opacity: 0.3; cursor: default; }
  #photo-viewer .pv-prev { left: 0.5rem; }
  #photo-viewer .pv-next { right: 0.5rem; }
  #photo-viewer .pv-nav[hidden] { display: none; }

  /* Camera settings */
  #photo-viewer .pv-album {
    margin: 0.25rem 2rem 0.75rem 0;
    font-size: 1.125rem;
    font-weight: 700;
  }
  #photo-viewer .pv-count {
    margin-left: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    opacity: 0.5;
  }
  #photo-viewer .pv-meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.375rem 1rem;
    margin: 0;
    font-size: 0.875rem;
  }
  #photo-viewer .pv-meta dt {
    opacity: 0.6;
  }
  #photo-viewer .pv-meta dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  #photo-viewer .pv-empty {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.6;
  }

  #photo-viewer .pv-heading {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Palette */
  #photo-viewer .pv-palette {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #photo-viewer .pv-swatch {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }
  #photo-viewer .pv-chip {
    width: 100%;
    aspect-ratio: 3 / 2;
    border-radius: 0.375rem;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
    transition: transform 0.15s ease;
  }
  #photo-viewer .pv-swatch:hover .pv-chip {
    transform: translateY(-2px);
  }
  #photo-viewer .pv-hex {
    margin-top: 0.25rem;
    font: 500 0.75rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  #photo-viewer .pv-share {
    font-size: 0.6875rem;
    opacity: 0.55;
  }
  #photo-viewer .pv-theme {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  /* Noise slider: compact row under the palette */
  #photo-viewer .pv-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  #photo-viewer .pv-slider {
    flex: 1;
    min-width: 0;
  }
  #photo-viewer .pv-t {
    min-width: 3.75rem;
    font: 500 0.75rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  /* While the page theme changes, fade every colour instead of snapping */
  html.theme-fading,
  html.theme-fading body,
  html.theme-fading body *:not(#photo-viewer *) {
    transition: background-color 0.6s ease, color 0.6s ease, fill 0.6s ease, border-color 0.6s ease !important;
  }
</style>
