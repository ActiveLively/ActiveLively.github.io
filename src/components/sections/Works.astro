---
import TimelineItem from '../TimelineItem.astro';
// Timeline entries are <TimelineItem> tags below, newest first: they show in
// the order you write them. Only date, type and title are required; text
// between the opening and closing tags becomes the description.
// See src/components/TimelineItem.astro for every option.
---

<section id="works" class="works-content">
    <h2 class="section-title">works</h2>

    <div class="timeline-block">
        <h3 class="timeline-heading">Timeline</h3>

        <ol class="timeline-list">
            <TimelineItem
                date=""
                type=""
                title="More on the way! (that's the plan at least :p)"
                detail=""
                authors=""
            >
            </TimelineItem>

            <TimelineItem
                date="Oct 2026"
                type="Patent"
                title="Conveyor health inspection method"
                detail="U.S. Patent 12,754,143 · Assignee: GM Global Technology Operations LLC"
                authors="D. J. Carroll, C. A. Wiley, D. R. Kracko, N. S. Ellis, P. L. Griggs, E. R. Newcomb, R. Hardin, and J. Huang"
            >
                Methods for analyzing sub-millimeter wear and structural stability of I-beams and double C-beams.
            </TimelineItem>
            <!-- To link the title, add: link="https://patents.google.com/patent/US12754143" -->
        </ol>
    </div>
</section>

<style>
    .works-content {
        /* Center the content in the middle of the screen */
        display: flex;
        flex-direction: column;
        justify-content: center;
        width: 100%;
        max-width: 100ch;
        margin: 0 auto;
        /* ---- Spacing (1rem = 16px) ---- */
        padding-top: 10rem;      /* GAP 2: space between About and Works (About's photo/text box adds 16px more above this) */
        padding-bottom: 10rem;   /* GAP 3: space between Works and the photography section */
        padding-left: 2rem;     /* space on the left side */
        padding-right: 2rem;    /* space on the right side */
        /* Size to the content instead of a full screen, to cut the empty space above and below */
        min-height: auto;
        color: var(--text-main);
    }
    .section-title {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 2rem;
        text-align: center;
    }

    /* ---- Timeline ---- */
    .timeline-block {
        width: 100%;
        max-width: 40rem;
        margin: 0 auto;
    }
    .timeline-heading {
        font-size: 1.25rem;
        font-weight: bold;
        margin-bottom: 1.25rem;
    }
    .timeline-list {
        list-style: none;
        margin: 0;
        padding: 0;
        /* The vertical line down the left side */
        border-left: 2px solid color-mix(in srgb, var(--text-main) 20%, transparent);
    }
</style>
