<section id="about" class="about-content">
    <div class="hero">
        <div class="hero-content flex-col lg:flex-row text-[--bg-page] max-w-3xl mx-auto px-8 gap-8 lg:gap-12">
            <img
                src="https://res.cloudinary.com/dvwdetmhx/image/upload/v1768860907/DSC_9237-Enhanced-NR_Original_1_mkrw4s.jpg"
                class="w-44 lg:w-56 shrink-0 rounded-lg shadow-2xl"
            />
            <div>
                <h1 class="text-4xl font-bold text-[var(--text-main)]">Howdy!</h1>
                <p class="py-3 text-sm leading-relaxed text-[var(--text-main)]">
                    Hi! My name is Joshua Huang! I'm a first year PhD student at Texas Tech University. I am advised by Professor 
                    <a
                        href="https://www.depts.ttu.edu/cs/faculty/Stas_tiomkin/stastiomkin.php"
                        target="_blank"
                        class="underline hover:text-gray-600 transition-colors text-[var(--text-main)]"
                    >Stas Tiomkin</a>
                    and am part of the <a
                        href="https://ci2ttu.github.io"
                        target="_blank"
                        class="underline hover:text-gray-600 transition-colors text-[var(--text-main)]"
                    >CI2 Lab</a>.
                    My current research interests include robot control, multi-modal sensing and processing, and process optimization.
                </p>
                <p class="py-3 text-sm leading-relaxed text-[var(--text-main)]">
                    Prior to Texas Tech, I completed my undergraduate degree in ECE at the University of Texas at Austin.
                    For fun, I enjoy photography, acoustic guitar, and being out and about. I also dabble in running, reading, volleyball, and other miscellaneous things.
                </p>

                <!-- Links row.
                     CV: the href below is the PDF's file name inside the public/ folder.
                     To update your CV, replace that file (or change the name here to match). -->
                <div class="about-links">
                    <a href="/Joshua_Huang___Resume.pdf" target="_blank" class="about-link">
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <path d="M14 2v6h6M8 13h8M8 17h5" />
                        </svg>
                        CV
                    </a>
                    <a href="https://www.linkedin.com/in/joshua-huang72" target="_blank" class="about-link">
                        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
