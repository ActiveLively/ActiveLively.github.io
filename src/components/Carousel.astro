---
// src/components/Carousel.astro

interface Props {
  images: string[];
  id?: string;
}

const { images } = Astro.props;
---

<div class="carousel-wrap">
  <div class="carousel carousel-center rounded-box">
    {images.map((imgSrc) => (
      <div class="carousel-item">
        <img src={imgSrc} class="h-96 w-auto object-cover" alt="Carousel image" />
      </div>
    ))}
  </div>

  <!-- Progress bar: fills up as you scroll through the photos -->
  <div class="carousel-progress" aria-hidden="true">
    <div class="carousel-progress-fill"></div>
  </div>
</div>

<style>
  .carousel-progress {
    width: 100%;
    max-width: 16rem;
    height: 4px;
    margin: 1rem auto 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--text-main) 15%, transparent);
    overflow: hidden;
  }
  .carousel-progress-fill {
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--text-main);
    transition: width 0.1s linear;
  }
</style>

<script>
  // Runs once for the page and wires up every carousel on it
  document.querySelectorAll<HTMLElement>('.carousel-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.carousel');
    const fill = wrap.querySelector<HTMLElement>('.carousel-progress-fill');
    if (!track || !fill) return;

    // How much of the row has been seen so far: starts at the visible share,
    // reaches 100% at the last photo
    const update = () => {
      const seen = (track.scrollLeft + track.clientWidth) / track.scrollWidth;
      fill.style.width = `${Math.min(100, seen * 100)}%`;
    };

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    // Photos load after the page, which changes the row's total width
    track.querySelectorAll('img').forEach((img) => img.addEventListener('load', update));
    update();
  });
</script>
