---
// src/components/Carousel.astro

import type { Photo } from '../lib/photos';

interface Props {
  images: Photo[];
  id?: string;
  album?: string;
}

const { images, album = '' } = Astro.props;
---

<div class="carousel-wrap">
  <div class="carousel carousel-center rounded-box">
    {images.map((photo) => (
      <div class="carousel-item">
        <!-- Small copy here; the viewer loads data-full (the original) when opened.
             width/height reserve the right space before the image arrives. -->
        <img
          src={photo.thumb}
          data-full={photo.full}
          width={photo.width}
          height={photo.height}
          loading="lazy"
          decoding="async"
          class="h-96 w-auto object-cover diffusable"
          alt={album ? `${album} photo` : 'Carousel image'}
          crossorigin="anonymous"
          draggable="false"
          tabindex="0"
          data-album={album}
          data-meta={JSON.stringify(photo.meta)}
        />
      </div>
    ))}
  </div>

  <!-- Progress bar: fills up as you scroll through the photos -->
  <div class="carousel-progress" aria-hidden="true">
    <div class="carousel-progress-fill"></div>
  </div>
</div>

<style>
  .carousel-progress {
    width: 100%;
    max-width: 16rem;
    height: 4px;
    margin: 1rem auto 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--text-main) 15%, transparent);
    overflow: hidden;
  }
  .carousel-progress-fill {
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--text-main);
    transition: width 0.1s linear;
  }

  /* Diffusion effect: the canvas sits exactly over the photo */
  .carousel-item {
    position: relative;
  }
  .diffusable {
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  .carousel-item :global(.diffusion-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .carousel-item :global(.diffusion-badge) {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border-radius: 0.375rem;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font: 500 0.75rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
</style>

<script>
  import { initHoldToDiffuse } from '../scripts/diffusion.js';
  import { openPhotoViewer } from '../scripts/photoViewer.js';

  // Hold a photo to diffuse it in place; a plain click opens the viewer
  const photos = document.querySelectorAll<HTMLImageElement>('.carousel-item img.diffusable');
  initHoldToDiffuse(photos, { onClick: openPhotoViewer });
  photos.forEach((img) =>
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openPhotoViewer(img);
      }
    })
  );

  // Runs once for the page and wires up every carousel on it
  document.querySelectorAll<HTMLElement>('.carousel-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('.carousel');
    const fill = wrap.querySelector<HTMLElement>('.carousel-progress-fill');
    if (!track || !fill) return;

    // How much of the row has been seen so far: starts at the visible share,
    // reaches 100% at the last photo
    const update = () => {
      const seen = (track.scrollLeft + track.clientWidth) / track.scrollWidth;
      fill.style.width = `${Math.min(100, seen * 100)}%`;
    };

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    // Photos load after the page, which changes the row's total width
    track.querySelectorAll('img').forEach((img) => img.addEventListener('load', update));
    update();
  });
</script>
